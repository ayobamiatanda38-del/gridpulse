# --- Database ---
# Any managed Postgres works: Railway, Render, Supabase, Neon, RDS, etc.
DATABASE_URL="postgresql://user:password@host:5432/gridpulse"

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- Market data providers ---
# ENTSO-E Transparency Platform: free day-ahead prices for EU bidding zones.
# Register at https://transparency.entsoe.eu/ (Account Settings > Web API Security Token).
ENTSOE_API_TOKEN="your-entsoe-token"

# Elexon BMRS (Insights Solution): free day-ahead / imbalance prices for GB.
# Register at https://bmrs.elexon.co.uk/ to obtain an API key.
ELEXON_API_KEY="your-elexon-key"

# Which provider powers each market at runtime. See src/services/marketData/index.js
# "demo" uses the seeded generator (no network / no key required) so the app
# runs out of the box before real credentials are configured.
MARKET_DATA_MODE="demo"   # demo | live

# --- Server ---
PORT=4000
CORS_ORIGIN="http://localhost:5173"
